{
  "$descripcion": "Marea Online · tokens de diseño. Mismos valores que css/tokens.css.",
  "color": {
    "logo": { "lima": "#C1D432", "olive": "#4D4D3F" },
    "abyss": "#1C1F17",
    "ink": "#2B2E24",
    "olive": "#45473B",
    "lima": "#C8DC3A",
    "limaHover": "#D6E763",
    "limaSoft": "#F1F6D6",
    "limaDeep": "#5B7B12",
    "limaDeeper": "#4C6710",
    "paper": "#F6F6F1",
    "stone": "#E9EAE0",
    "line": "#E3E4DA",
    "lineStrong": "#D9DBCD",
    "muted": "#676A5A",
    "white": "#FFFFFF"
  },
  "font": {
    "display": { "family": "Bricolage Grotesque", "weights": [500, 600, 700, 800], "letterSpacing": "-0.03em" },
    "body": { "family": "Instrument Sans", "weights": [400, 500, 600] }
  },
  "fontSize": {
    "12": "0.75rem", "13": "0.8125rem", "14": "0.875rem", "15": "0.9375rem", "16": "1rem",
    "17": "1.0625rem", "18": "1.125rem", "20": "1.25rem", "22": "1.375rem", "26": "1.625rem",
    "h3": "clamp(1.375rem, 1.2rem + .6vw, 1.625rem)",
    "h2": "clamp(2.125rem, 1.6rem + 1.9vw, 3rem)",
    "h1": "clamp(2.625rem, 1.7rem + 3.6vw, 4.125rem)"
  },
  "space": { "1": "0.25rem", "2": "0.5rem", "3": "0.75rem", "4": "1rem", "5": "1.25rem", "6": "1.5rem", "7": "1.75rem", "8": "2rem", "10": "2.5rem", "12": "3rem", "14": "3.5rem", "16": "4rem", "20": "5rem", "24": "6rem" },
  "radius": { "sm": "9px", "md": "12px", "lg": "16px", "xl": "24px", "2xl": "28px", "3xl": "32px", "pill": "999px" },
  "shadow": {
    "card": "0 1px 2px rgba(28,31,23,.04), 0 12px 32px -12px rgba(28,31,23,.12)",
    "lift": "0 24px 48px -16px rgba(28,31,23,.22)",
    "float": "0 30px 60px -20px rgba(0,0,0,.5)",
    "lima": "0 10px 24px -10px rgba(170,196,40,.65)"
  },
  "layout": { "container": "1200px", "gutter": { "mobile": "20px", "tablet": "40px" }, "sectionY": { "mobile": "64px", "desktop": "96px" }, "navHeight": "64px" },
  "breakpoints": { "xs": "480px", "sm": "640px", "md": "768px", "lg": "1024px" },
  "motion": { "easeOut": "cubic-bezier(.16, 1, .3, 1)", "fast": "0.2s", "base": "0.35s" }
}
